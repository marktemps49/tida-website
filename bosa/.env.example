# Copy to .env and fill in. Never commit the real .env file.

# Gmail account Bosa monitors for incoming deal emails.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_WATCH_ADDRESS=

# TAPP (TIDA Private Client App) integration — fill in once TAPP's
# API/ingestion method is confirmed.
TAPP_API_BASE_URL=
TAPP_API_KEY=

# CapitalRise: automated form login doesn't work (their login is behind
# reCAPTCHA — see CLAUDE.md). SOURCE_CAPITALRISE_SESSION_STATE holds a
# pre-authenticated session instead, generated by a human running
# scripts/capitalrise-save-session.js on their own machine. Paste the
# entire contents of the resulting capitalrise-session.json file as the
# value (it's JSON, so it'll span multiple lines — that's fine in .env
# with quotes, and fine as a GitHub Actions secret value either way).
SOURCE_CAPITALRISE_SESSION_STATE=
